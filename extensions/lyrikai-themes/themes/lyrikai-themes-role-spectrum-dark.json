  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A0A4CBB3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#76E5C0"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.other.import",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#F1B774"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.method"
      ],
      "settings": {
        "foreground": "#80A5EF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.class",
        "storage.type.interface"
      ],
      "settings": {
        "foreground": "#8A8CEF"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#F1A67E"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#73DED3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#EFAE80"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#E38AEF"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#EB7A83"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#EA7B7B"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#81CAEE"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#F1B774"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "support.type.namespace"
      ],
      "settings": {
        "foreground": "#7B99EA"
      }
    },
    {
      "scope": [
        "entity.name.type.parameter",
        "meta.type.parameters"
      ],
      "settings": {
        "foreground": "#BD8CEE",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.enummember",
        "variable.other.enumMember"
      ],
      "settings": {
        "foreground": "#B1DE73"
      }
    },
    {
      "scope": [
        "variable.other.readonly",
        "storage.modifier.readonly"
      ],
      "settings": {
        "foreground": "#97AAC4"
      }
    },
    {
      "scope": [
        "variable.other.global",
        "storage.modifier.global"
      ],
      "settings": {
        "foreground": "#EF8098",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "storage.modifier.static",
        "variable.other.static"
      ],
      "settings": {
        "foreground": "#EF8098",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#E8EAFF66"
      }
    },
    {
      "scope": [
        "markup.heading.1",
        "heading.1"
      ],
      "settings": {
        "foreground": "#BD8CEE",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.2",
        "heading.2"
      ],
      "settings": {
        "foreground": "#E38AEF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.3",
        "heading.3"
      ],
      "settings": {
        "foreground": "#EF8098",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#BD8CEE",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F1A67E",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#EFAE80",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#80A5EF"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#E38AEF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.raw",
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#8A8CEF"
      }
    },
    {
      "scope": [
        "source.diff markup.inserted"
      ],
      "settings": {
        "foreground": "#76E5C0"
      }
    },
    {
      "scope": [
        "source.diff markup.deleted"
      ],
      "settings": {
        "foreground": "#EA7B7B"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#EA7B7B"
      }
    }
  ],
  "semanticHighlighting": true,
