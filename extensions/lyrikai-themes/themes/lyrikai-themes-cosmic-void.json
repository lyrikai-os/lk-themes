  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6B7280B3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#6EE7B7"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.other.import",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#C4A0FF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.method"
      ],
      "settings": {
        "foreground": "#7DD3FC"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.class",
        "storage.type.interface"
      ],
      "settings": {
        "foreground": "#A78BFA"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#F0ABFC"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#94A3B8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#E879F9"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#F472B6"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FDBA74"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#FCA5A5"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#67E8F9"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#C4A0FF"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "support.type.namespace"
      ],
      "settings": {
        "foreground": "#93C5FD"
      }
    },
    {
      "scope": [
        "entity.name.type.parameter",
        "meta.type.parameters"
      ],
      "settings": {
        "foreground": "#C084FC",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.enummember",
        "variable.other.enumMember"
      ],
      "settings": {
        "foreground": "#86EFAC"
      }
    },
    {
      "scope": [
        "variable.other.readonly",
        "storage.modifier.readonly"
      ],
      "settings": {
        "foreground": "#CBD5E1"
      }
    },
    {
      "scope": [
        "variable.other.global",
        "storage.modifier.global"
      ],
      "settings": {
        "foreground": "#FDE68A",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "storage.modifier.static",
        "variable.other.static"
      ],
      "settings": {
        "foreground": "#FDE68A",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#E8EAFF33"
      }
    },
    {
      "scope": [
        "markup.heading.1",
        "heading.1"
      ],
      "settings": {
        "foreground": "#C084FC",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.2",
        "heading.2"
      ],
      "settings": {
        "foreground": "#A78BFA",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.3",
        "heading.3"
      ],
      "settings": {
        "foreground": "#818CF8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#C084FC",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F0ABFC",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#E879F9",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#7DD3FC"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#F472B6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.raw",
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#A78BFA"
      }
    },
    {
      "scope": [
        "source.diff markup.inserted"
      ],
      "settings": {
        "foreground": "#6EE7B7"
      }
    },
    {
      "scope": [
        "source.diff markup.deleted"
      ],
      "settings": {
        "foreground": "#FCA5A5"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FCA5A5"
      }
    }
  ],
  "semanticHighlighting": true,
