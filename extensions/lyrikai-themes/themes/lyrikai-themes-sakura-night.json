  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A08898B3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#A7F3D0"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.other.import"
      ],
      "settings": {
        "foreground": "#FBCFE8"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.method"
      ],
      "settings": {
        "foreground": "#FDA4AF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.class",
        "storage.type.interface"
      ],
      "settings": {
        "foreground": "#C4B5FD"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#FCA5A5"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#FB7185"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#E879F9"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#FB7185"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FDE68A"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#F0ABFC"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FBCFE8"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#FFF0F533"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#FBCFE8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FCA5A5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#FB7185",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#FDA4AF"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#E879F9",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#C4B5FD"
      }
    },
    {
      "scope": [
        "source.diff markup.inserted"
      ],
      "settings": {
        "foreground": "#A7F3D0"
      }
    },
    {
      "scope": [
        "source.diff markup.deleted"
      ],
      "settings": {
        "foreground": "#FDE68A"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FDE68A"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": {
      "foreground": "#FDA4AF"
    },
    "method": {
      "foreground": "#FDA4AF"
    },
    "keyword": {
      "foreground": "#FBCFE8"
    },
    "type": {
      "foreground": "#C4B5FD"
    },
    "class": {
      "foreground": "#C4B5FD"
    },
    "interface": {
      "foreground": "#C4B5FD"
    },
    "enum": {
      "foreground": "#C4B5FD"
    },
    "enumMember": {
      "foreground": "#C4B5FD"
    },
    "namespace": {
      "foreground": "#FDA4AF"
    },
    "variable": {
      "foreground": "#FCA5A5"
    },
    "parameter": {
      "foreground": "#E879F9"
    },
    "property": {
      "foreground": "#FB7185"
    },
    "string": {
      "foreground": "#A7F3D0"
    },
    "comment": {
      "foreground": "#A08898B3",
      "fontStyle": "italic"
    },
    "*.declaration": {
      "foreground": "#C4B5FD"
    },
    "*.definition": {
      "foreground": "#FDA4AF"
    },
    "decorator": {
      "foreground": "#E879F9"
    },
    "macro": {
      "foreground": "#E879F9"
    }
  }
}
