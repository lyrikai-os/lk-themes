  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A89080B3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#84CC16"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.other.import"
      ],
      "settings": {
        "foreground": "#EF4444"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.method"
      ],
      "settings": {
        "foreground": "#48CAE4"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.class",
        "storage.type.interface"
      ],
      "settings": {
        "foreground": "#A855F7"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#FB7185"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#F97316"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#EC4899"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#F97316"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FBBF24"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#22D3EE"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#EF4444"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#F5E6D333"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#EF4444",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FB7185",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#F97316",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#48CAE4"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#EC4899",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#A855F7"
      }
    },
    {
      "scope": [
        "source.diff markup.inserted"
      ],
      "settings": {
        "foreground": "#84CC16"
      }
    },
    {
      "scope": [
        "source.diff markup.deleted"
      ],
      "settings": {
        "foreground": "#FBBF24"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FBBF24"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": {
      "foreground": "#48CAE4"
    },
    "method": {
      "foreground": "#48CAE4"
    },
    "keyword": {
      "foreground": "#EF4444"
    },
    "type": {
      "foreground": "#A855F7"
    },
    "class": {
      "foreground": "#A855F7"
    },
    "interface": {
      "foreground": "#A855F7"
    },
    "enum": {
      "foreground": "#A855F7"
    },
    "enumMember": {
      "foreground": "#A855F7"
    },
    "namespace": {
      "foreground": "#48CAE4"
    },
    "variable": {
      "foreground": "#FB7185"
    },
    "parameter": {
      "foreground": "#EC4899"
    },
    "property": {
      "foreground": "#F97316"
    },
    "string": {
      "foreground": "#84CC16"
    },
    "comment": {
      "foreground": "#A89080B3",
      "fontStyle": "italic"
    },
    "*.declaration": {
      "foreground": "#A855F7"
    },
    "*.definition": {
      "foreground": "#48CAE4"
    },
    "decorator": {
      "foreground": "#EC4899"
    },
    "macro": {
      "foreground": "#EC4899"
    }
  }
}
