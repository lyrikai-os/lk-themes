  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9A8E87B3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#3D9A00"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.other.import"
      ],
      "settings": {
        "foreground": "#C49400"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.method"
      ],
      "settings": {
        "foreground": "#0095A8"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.class",
        "storage.type.interface"
      ],
      "settings": {
        "foreground": "#7B52C4"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#D45030"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#E07800"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#C21884"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#E07800"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#E03030"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#008899"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#C49400"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#2A1F1866"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#C49400",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#D45030",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#E07800",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#0095A8"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#C21884",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#7B52C4"
      }
    },
    {
      "scope": [
        "source.diff markup.inserted"
      ],
      "settings": {
        "foreground": "#3D9A00"
      }
    },
    {
      "scope": [
        "source.diff markup.deleted"
      ],
      "settings": {
        "foreground": "#E03030"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E03030"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": {
      "foreground": "#0095A8"
    },
    "method": {
      "foreground": "#0095A8"
    },
    "keyword": {
      "foreground": "#C49400"
    },
    "type": {
      "foreground": "#7B52C4"
    },
    "class": {
      "foreground": "#7B52C4"
    },
    "interface": {
      "foreground": "#7B52C4"
    },
    "enum": {
      "foreground": "#7B52C4"
    },
    "enumMember": {
      "foreground": "#7B52C4"
    },
    "namespace": {
      "foreground": "#0095A8"
    },
    "variable": {
      "foreground": "#D45030"
    },
    "parameter": {
      "foreground": "#C21884"
    },
    "property": {
      "foreground": "#E07800"
    },
    "string": {
      "foreground": "#3D9A00"
    },
    "comment": {
      "foreground": "#9A8E87B3",
      "fontStyle": "italic"
    },
    "*.declaration": {
      "foreground": "#7B52C4"
    },
    "*.definition": {
      "foreground": "#0095A8"
    },
    "decorator": {
      "foreground": "#C21884"
    },
    "macro": {
      "foreground": "#C21884"
    }
  }
}
