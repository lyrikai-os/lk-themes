  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8A8078B3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#16A34A"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.other.import"
      ],
      "settings": {
        "foreground": "#1D4ED8"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.method"
      ],
      "settings": {
        "foreground": "#0077BB"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.class",
        "storage.type.interface"
      ],
      "settings": {
        "foreground": "#7C3AED"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#DC2626"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#EA580C"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#DB2777"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#EA580C"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#CA8A04"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#0284C7"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#1D4ED8"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#1A141066"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#1D4ED8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#DC2626",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#EA580C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#0077BB"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#DB2777",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#7C3AED"
      }
    },
    {
      "scope": [
        "source.diff markup.inserted"
      ],
      "settings": {
        "foreground": "#16A34A"
      }
    },
    {
      "scope": [
        "source.diff markup.deleted"
      ],
      "settings": {
        "foreground": "#CA8A04"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#CA8A04"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": {
      "foreground": "#0077BB"
    },
    "method": {
      "foreground": "#0077BB"
    },
    "keyword": {
      "foreground": "#1D4ED8"
    },
    "type": {
      "foreground": "#7C3AED"
    },
    "class": {
      "foreground": "#7C3AED"
    },
    "interface": {
      "foreground": "#7C3AED"
    },
    "enum": {
      "foreground": "#7C3AED"
    },
    "enumMember": {
      "foreground": "#7C3AED"
    },
    "namespace": {
      "foreground": "#0077BB"
    },
    "variable": {
      "foreground": "#DC2626"
    },
    "parameter": {
      "foreground": "#DB2777"
    },
    "property": {
      "foreground": "#EA580C"
    },
    "string": {
      "foreground": "#16A34A"
    },
    "comment": {
      "foreground": "#8A8078B3",
      "fontStyle": "italic"
    },
    "*.declaration": {
      "foreground": "#7C3AED"
    },
    "*.definition": {
      "foreground": "#0077BB"
    },
    "decorator": {
      "foreground": "#DB2777"
    },
    "macro": {
      "foreground": "#DB2777"
    }
  }
}
