  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#4ADE8080",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#00FF66"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.other.import",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#FF00AA"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.method"
      ],
      "settings": {
        "foreground": "#00FF88"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.class",
        "storage.type.interface"
      ],
      "settings": {
        "foreground": "#00CC66"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#FF66CC"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#86EFAC",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#FF3399"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#FF00FF"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FFAA00"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#FF4466"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#00FFAA"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FF00AA"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "support.type.namespace"
      ],
      "settings": {
        "foreground": "#00FF88"
      }
    },
    {
      "scope": [
        "entity.name.type.parameter",
        "meta.type.parameters"
      ],
      "settings": {
        "foreground": "#FF66CC",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.enummember",
        "variable.other.enumMember"
      ],
      "settings": {
        "foreground": "#00FF66"
      }
    },
    {
      "scope": [
        "variable.other.readonly",
        "storage.modifier.readonly"
      ],
      "settings": {
        "foreground": "#A7F3D0"
      }
    },
    {
      "scope": [
        "variable.other.global",
        "storage.modifier.global"
      ],
      "settings": {
        "foreground": "#FF00AA",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "storage.modifier.static",
        "variable.other.static"
      ],
      "settings": {
        "foreground": "#FF00AA",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#00FF4133"
      }
    },
    {
      "scope": [
        "markup.heading.1",
        "heading.1"
      ],
      "settings": {
        "foreground": "#00FF88",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.2",
        "heading.2"
      ],
      "settings": {
        "foreground": "#FF00AA",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.3",
        "heading.3"
      ],
      "settings": {
        "foreground": "#00CC66",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#00FF88",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FF66CC",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#FF3399",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#00FF88"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#FF00FF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.raw",
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#00CC66"
      }
    },
    {
      "scope": [
        "source.diff markup.inserted"
      ],
      "settings": {
        "foreground": "#00FF66"
      }
    },
    {
      "scope": [
        "source.diff markup.deleted"
      ],
      "settings": {
        "foreground": "#FF4466"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF4466"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": {
      "foreground": "#00FF88"
