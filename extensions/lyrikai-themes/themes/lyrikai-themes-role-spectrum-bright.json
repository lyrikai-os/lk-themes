  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6B7099B3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#1D9A71"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.other.import",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#BA6C12"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.method"
      ],
      "settings": {
        "foreground": "#1548AC"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.class",
        "storage.type.interface"
      ],
      "settings": {
        "foreground": "#1A1CBC"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#C15115"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#239589",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#BF5D18"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#AA1ABC"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#C31D2B"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#C11F1F"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#1880B4"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#BA6C12"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "support.type.namespace"
      ],
      "settings": {
        "foreground": "#1D44AF"
      }
    },
    {
      "scope": [
        "entity.name.type.parameter",
        "meta.type.parameters"
      ],
      "settings": {
        "foreground": "#6B1CBA",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.enummember",
        "variable.other.enumMember"
      ],
      "settings": {
        "foreground": "#659523"
      }
    },
    {
      "scope": [
        "variable.other.readonly",
        "storage.modifier.readonly"
      ],
      "settings": {
        "foreground": "#496183"
      }
    },
    {
      "scope": [
        "variable.other.global",
        "storage.modifier.global"
      ],
      "settings": {
        "foreground": "#BF183C",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "storage.modifier.static",
        "variable.other.static"
      ],
      "settings": {
        "foreground": "#BF183C",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#1A1D2E66"
      }
    },
    {
      "scope": [
        "markup.heading.1",
        "heading.1"
      ],
      "settings": {
        "foreground": "#6B1CBA",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.2",
        "heading.2"
      ],
      "settings": {
        "foreground": "#AA1ABC",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.3",
        "heading.3"
      ],
      "settings": {
        "foreground": "#BF183C",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#6B1CBA",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#C15115",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#BF5D18",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#1548AC"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#AA1ABC",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.raw",
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#1A1CBC"
      }
    },
    {
      "scope": [
        "source.diff markup.inserted"
      ],
      "settings": {
        "foreground": "#1D9A71"
      }
    },
    {
      "scope": [
        "source.diff markup.deleted"
      ],
      "settings": {
        "foreground": "#C11F1F"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#C11F1F"
      }
    }
  ],
  "semanticHighlighting": true,
