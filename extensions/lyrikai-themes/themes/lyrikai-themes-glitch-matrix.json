    "method.declaration": {
      "foreground": "#00FF88",
      "fontStyle": "bold"
    },
    "keyword": {
      "foreground": "#FF00AA"
    },
    "type": {
      "foreground": "#00CC66"
    },
    "class": {
      "foreground": "#00CC66"
    },
    "interface": {
      "foreground": "#33FF99"
    },
    "enum": {
      "foreground": "#00CC66"
    },
    "enumMember": {
      "foreground": "#00FF66"
    },
    "namespace": {
      "foreground": "#00FF88"
    },
    "variable": {
      "foreground": "#FF66CC"
    },
    "variable.readonly": {
      "foreground": "#A7F3D0"
    },
    "variable.defaultLibrary": {
      "foreground": "#FF00AA",
      "fontStyle": "bold"
    },
    "parameter": {
      "foreground": "#86EFAC",
      "fontStyle": "italic"
    },
    "property": {
      "foreground": "#FF3399"
    },
    "property.readonly": {
      "foreground": "#A7F3D0"
    },
    "string": {
      "foreground": "#00FF66"
    },
    "number": {
      "foreground": "#FFAA00"
    },
    "comment": {
      "foreground": "#4ADE8080",
      "fontStyle": "italic"
    },
    "macro": {
      "foreground": "#FF00FF"
    },
    "decorator": {
      "foreground": "#FF00FF"
    },
    "typeParameter": {
      "foreground": "#FF66CC",
      "fontStyle": "italic"
    },
    "*.declaration": {
      "foreground": "#00CC66"
    },
    "*.definition": {
      "foreground": "#00FF88",
      "fontStyle": "bold"
    },
    "*.async": {
      "fontStyle": "italic"
    },
    "*.readonly": {
      "foreground": "#A7F3D0"
    },
    "*.static": {
      "foreground": "#FF00AA",
      "fontStyle": "bold"
    },
    "*.global": {
      "foreground": "#FF00AA",
      "fontStyle": "bold"
    },
    "*.defaultLibrary": {
      "foreground": "#FF00AA",
      "fontStyle": "bold"
    },
    "selfParameter": {
      "foreground": "#FF00AA",
      "fontStyle": "italic"
    },
    "struct": {
      "foreground": "#00CC66"
    },
    "event": {
      "foreground": "#00CC66"
    },
    "modifier": {
      "foreground": "#FF00AA"
    },
    "operator": {
      "foreground": "#00FF4133"
    },
    "regexp": {
      "foreground": "#00FF66"
    },
    "label": {
      "foreground": "#FF3399"
    }
  }
}
